# --- Mesure d'audience (chargée seulement après consentement, Loi 25) ---
NEXT_PUBLIC_GA_ID=                 # ex. G-XXXXXXXXXX (Google Analytics 4)
NEXT_PUBLIC_GTM_ID=GTM-M94CRN5M    # conteneur Google Tag Manager déjà utilisé sur bellechasseenergie.ca
NEXT_PUBLIC_GOOGLE_ADS_ID=         # ex. AW-XXXXXXXXX
NEXT_PUBLIC_ADS_LEAD_LABEL=        # ex. AW-XXXXXXXXX/AbCdEfGhIj (conversion « lead »)

# --- CRM Pipedrive (même compte que thermopompesavendre.ca) : chaque demande devient une personne
# + une affaire [BE] dans le pipeline des ventes (champ « Site web » = bellechasseenergie.com), chaque
# rendez-vous ajoute une activité « réunion ». Jeton : Pipedrive → Paramètres → Personnel → API.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_PIPELINE_ID=3            # pipeline « 1. VENTES (Acquisition) »
PIPEDRIVE_OWNER_ID=                # facultatif : ID de l'utilisateur propriétaire des affaires

# --- Journal local des leads (défaut : ./data/leads) ---
LEAD_JOURNAL_DIR=

# --- Courriels (facultatif si Pipedrive est configuré) via Resend ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@bellechasseenergie.ca
CONTACT_FROM_EMAIL="Bellechasse Énergie <site@bellechasseenergie.ca>"
RENDEZVOUS_TO_EMAIL=               # facultatif, sinon CONTACT_TO_EMAIL

# --- Stockage des rendez-vous ---
# Par défaut : fichier data/rendez-vous.json (serveur avec disque).
# Sur Vercel ou autre hébergement sans disque : Upstash Redis (REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BOOKINGS_FILE=                     # facultatif : chemin absolu du fichier JSON
